# Freedom GP$ API — environment variables.
# Copy to .env and fill in real values. Never commit a real .env.
# No secrets are stored in this repository.

# App
DEBUG=false
CORS_ORIGINS=*

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://freedom:freedom@localhost:5432/freedom_gps

# Redis (cache / Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT authentication — CHANGE THIS in production to a long random secret.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
